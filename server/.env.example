# Copy this file to .env and fill in real values

# MongoDB connection string (local install or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ntg-platform

# Secret used to sign JWT login tokens - make this a long random string
JWT_SECRET=change-this-to-a-long-random-secret-string

# Port the backend listens on
PORT=4000

# The URL the frontend is served from (for CORS). For local event-day Wi-Fi
# hosting this is the host laptop's LAN IP, e.g. http://192.168.1.50:5173
CLIENT_ORIGIN=http://localhost:5173
